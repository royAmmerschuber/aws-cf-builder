{
  "$schema": "https://json.schemastore.org/tsconfig",
  "compilerOptions": {
    "typeRoots": [
      "../types",
      "../../../node_modules/@types"
    ],
    "target": "ES2022",
    "lib": [
      "es2023"
    ],
    "module": "commonjs",
    "outDir": "out",
    "sourceMap": true,
    "strict": false,
    "skipLibCheck": true,
    "esModuleInterop": true
  },
  "include": [
    "**/*.cf.ts"
  ]
}
